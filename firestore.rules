rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Les deux seuls comptes, énumérés UNE fois.
    //
    // Cette liste existait en double : une copie pour « qui a le droit
    // d'entrer », une autre pour « à qui un document peut être attribué ». Deux
    // listes du même fait finissent par diverger, et celle qu'on oublie de
    // mettre à jour n'échoue pas bruyamment — elle laisse simplement passer, ou
    // refuse, sans qu'on sache laquelle a parlé.
    function isValidPersonUid(uid) {
      return uid == "J8xOqDWZv5gEss5CBbQ7kQOsTwV2"
        || uid == "o8wLosYoh7b989P9gQyZCk8tt3l1";
    }

    // Only Lise and Clément can access the shared couple space.
    function isAuthorizedUser() {
      return request.auth != null && isValidPersonUid(request.auth.uid);
    }

    function hasValidMetadata(data) {
      return isValidPersonUid(data.createdBy)
        && isValidPersonUid(data.updatedBy)
        && data.updatedBy == request.auth.uid;
    }

    function isValidAccountId(id) {
      return id == "joint" || id == "clement" || id == "lise";
    }

    // La répartition : "common" (50/50) ou l'uid de celui qui la supporte.
    function isValidSplit(value) {
      return value == "common" || isValidPersonUid(value);
    }

    function isValidRecurrence(value) {
      return value == "one-off"
        || value == "weekly"
        || value == "fortnightly"
        || value == "monthly";
    }

    // Une dépense sort d'un compte, un revenu entre sur un compte, un
    // virement fait les deux — et jamais depuis et vers le même compte.
    function hasValidAccountRouting(data) {
      return (data.kind == "expense" && isValidAccountId(data.fromAccount))
        || (data.kind == "income" && isValidAccountId(data.toAccount))
        || (data.kind == "transfer"
            && isValidAccountId(data.fromAccount)
            && isValidAccountId(data.toAccount)
            && data.fromAccount != data.toAccount);
    }

    // Taux EUR→AUD figé à la saisie. Borné large : au-delà, c'est une faute
    // de frappe, pas un taux de change.
    function isValidRate(data) {
      return !('rate' in data)
        || data.rate == null
        || (data.rate is number && data.rate > 0 && data.rate < 100);
    }

    function hasValidTransactionShape(data) {
      return data.title is string
        && data.amount is number
        && data.amount >= 0
        && (data.currency == "EUR" || data.currency == "AUD")
        && (data.kind == "income" || data.kind == "expense" || data.kind == "transfer")
        && hasValidAccountRouting(data)
        && isValidSplit(data.split)
        && isValidRecurrence(data.recurrence)
        && isValidRate(data)
        && (data.amountReceived == null
            || (data.amountReceived is number && data.amountReceived >= 0))
        // Provenance d'un import de relevé : l'identifiant que la banque a
        // donné à l'opération, et le format du fichier. Bornés : ils viennent
        // d'un fichier que personne n'a relu ligne à ligne.
        && (!('externalId' in data)
            || data.externalId == null
            || (data.externalId is string && data.externalId.size() <= 200))
        && (!('source' in data)
            || data.source == null
            || (data.source is string && data.source.size() <= 20));
    }

    // Transactions
    match /couples/main/transactions/{transactionId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidTransactionShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidTransactionShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    // Settings (single shared doc)
    match /couples/main/settings/{settingsId} {
      allow read: if isAuthorizedUser();

      allow create, update: if isAuthorizedUser()
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    function hasValidShoppingItemShape(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.aisle is string
        && data.checked is bool
        && (!('quantityLabel' in data) || data.quantityLabel == null || (data.quantityLabel is string && data.quantityLabel.size() <= 40))
        && (!('quantity' in data) || data.quantity == null || (data.quantity is number && data.quantity >= 0))
        && (!('unit' in data) || data.unit == null || (data.unit is string && data.unit.size() <= 20))
        && (!('listId' in data) || data.listId == null || (data.listId is string && data.listId.size() <= 120))
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500));
    }

    function hasValidShoppingListShape(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && (data.status == "active" || data.status == "archived")
        && (!('archivedAt' in data) || data.archivedAt == null || (data.archivedAt is string && data.archivedAt.size() <= 40));
    }

    // Shopping lists (named lists: create / archive for traceability / delete)
    match /couples/main/shoppingLists/{listId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidShoppingListShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidShoppingListShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    // Shopping list items (scoped to a list via listId)
    match /couples/main/shoppingItems/{itemId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidShoppingItemShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidShoppingItemShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    function hasValidCatalogShape(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.nameLower is string
        && data.aisle is string
        && data.favorite is bool
        && data.useCount is number
        && data.useCount >= 0;
    }

    // Shopping catalog (known products: frequents/favorites/remembered aisle)
    match /couples/main/shoppingCatalog/{slug} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidCatalogShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidCatalogShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    function hasValidPantryItemShape(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.aisle is string
        && (data.status == "ok" || data.status == "low" || data.status == "out")
        && (!('quantityLabel' in data) || data.quantityLabel == null || (data.quantityLabel is string && data.quantityLabel.size() <= 40))
        && (!('quantity' in data) || data.quantity == null || (data.quantity is number && data.quantity >= 0))
        && (!('unit' in data) || data.unit == null || (data.unit is string && data.unit.size() <= 20))
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500));
    }

    // Pantry / stock (what we have at home: fridge, cupboards)
    match /couples/main/pantryItems/{itemId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidPantryItemShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidPantryItemShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    function hasValidRecipeShape(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.ingredients is list
        && data.ingredients.size() <= 50
        && data.steps is list
        && data.steps.size() <= 30
        && (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500))
        && (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('servings' in data) || data.servings == null || (data.servings is number && data.servings >= 0))
        && (!('prepMinutes' in data) || data.prepMinutes == null || (data.prepMinutes is number && data.prepMinutes >= 0));
    }

    // Recipes (title + ingredients + preparation steps)
    match /couples/main/recipes/{recipeId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidRecipeShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidRecipeShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    function hasValidFoodShape(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.source in ['off', 'ciqual', 'manual']
        && data.per100 is map
        && data.per100.kcal is number
        && data.per100.kcal >= 0
        && data.per100.kcal <= 1000
        && (!('brand' in data) || data.brand == null || (data.brand is string && data.brand.size() <= 120))
        && (!('barcode' in data) || data.barcode == null || (data.barcode is string && data.barcode.size() <= 20))
        && (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('gramsPerPiece' in data) || data.gramsPerPiece == null || (data.gramsPerPiece is number && data.gramsPerPiece > 0))
        && (!('densityGPerMl' in data) || data.densityGPerMl == null || (data.densityGPerMl is number && data.densityGPerMl > 0))
        && (!('servingGrams' in data) || data.servingGrams == null || (data.servingGrams is number && data.servingGrams > 0));
    }

    // Bibliotheque d'aliments : fiches nutritionnelles scannees, importees ou
    // saisies a la main. Partagee dans le couple, comme le catalogue de courses.
    match /couples/main/foods/{foodId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidFoodShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidFoodShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    function hasValidMealPlanShape(data) {
      return data.date is string
        && data.date.size() == 10
        && (!('midi' in data) || data.midi is list)
        && (!('soir' in data) || data.soir is list);
    }

    // Meal plan (one doc per day; meals tagged per person)
    match /couples/main/mealPlan/{dayId} {
      allow read: if isAuthorizedUser();

      allow create: if isAuthorizedUser()
        && hasValidMealPlanShape(request.resource.data)
        && hasValidMetadata(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthorizedUser()
        && hasValidMealPlanShape(request.resource.data)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isAuthorizedUser();
    }

    // ---------------------------------------------------------------
    // MuscAuzi
    // ---------------------------------------------------------------

    // Seul le propriétaire touche ses séances, ses courbes et ses pesées :
    // aucune vue partagée entre les deux profils.
    //
    // `isOwner` prouve DÉJÀ qui écrit — `request.auth.uid` est le segment de
    // chemin lui-même. Revalider `updatedBy` par-dessus, comme le fait l'espace
    // partagé où plusieurs mains écrivent dans le même document, n'ajouterait
    // aucune garantie ici : ça ne ferait que multiplier les façons de refuser
    // une écriture légitime à laquelle il manque un champ décoratif.
    function isOwner(uid) {
      return isAuthorizedUser() && request.auth.uid == uid;
    }

    function isDateId(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isExerciseType(value) {
      return value == "barbell" || value == "dumbbell"
        || value == "machine" || value == "bodyweight";
    }

    // Catalogue d'exercices — PERSONNEL, comme le reste des données.
    //
    // Il a été commun aux deux profils au départ : supprimer un exercice
    // depuis un compte le supprimait chez l'autre et laissait son programme
    // pointer dans le vide. Chacun a désormais le sien.
    //
    // Le TYPE porte tout : « se compte en reps » découle de
    // `type == "bodyweight"`. Un champ `bodyweight` a existé à côté, dupliquant
    // le type et pouvant le contredire ; il n'est plus ni écrit ni exigé. Les
    // documents qui en portent encore un restent valides, il est ignoré.
    match /users/{uid}/exercises/{exerciseId} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && isExerciseType(request.resource.data.type);

      allow delete: if isOwner(uid);
    }

    // ── Pourquoi `create, update` et jamais `write` ────────────────────────
    //
    // `write` couvre AUSSI la suppression. Or lors d'une suppression
    // `request.resource` est nul : la condition déréférençait alors du vide,
    // l'expression partait en erreur, et la règle refusait — pas par décision,
    // par accident. Une suppression qu'on voudrait autoriser un jour aurait
    // échoué sans qu'aucune ligne ici ne dise pourquoi. Chaque verbe est donc
    // énoncé, et `delete` répond pour lui-même.

    // Programme : un document par parité de semaine, contenant les sept jours.
    match /users/{uid}/program/{parity} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (parity == "even" || parity == "odd")
        && request.resource.data.days is map
        // Sept jours, pas un de plus : une clé inattendue serait un bogue
        // d'écriture, et un document de programme n'a aucune raison d'enfler.
        && request.resource.data.days.size() <= 7
        // Nom de la séance par jour — écrit séparément des lignes, donc
        // validé seulement quand il fait partie de la requête.
        && (!("dayNames" in request.resource.data)
            || (request.resource.data.dayNames is map
                && request.resource.data.dayNames.size() <= 7));
      allow delete: if isOwner(uid);
    }

    // Séances. `entries` est une map indexée par instanceId (l'occurrence de
    // l'exercice dans le programme) ; chaque entrée porte son exerciceId, son
    // libellé et sa prescription figés. `parity` et `dayOfWeek` décrivent la
    // séance affichée au moment de la saisie — l'ancienne copie du programme
    // (`programSnapshot`) n'est plus écrite, seulement relue.
    match /users/{uid}/sessions/{dateId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isDateId(dateId)
        && request.resource.data.entries is map
        // `parity` et `dayOfWeek` ne sont validés QUE s'ils sont là.
        //
        // Les exiger sur toute écriture cassait le nettoyage : supprimer un
        // exercice fusionne un retrait d'entrées dans chaque séance concernée,
        // sans connaître la parité de séances écrites avant que ce champ
        // n'existe. L'état fusionné n'en portait donc pas, la règle refusait, et
        // c'est le LOT ENTIER qui échouait — l'exercice restait au catalogue
        // sans que rien n'explique le refus.
        && (!("parity" in request.resource.data)
            || request.resource.data.parity == "even"
            || request.resource.data.parity == "odd")
        && (!("dayOfWeek" in request.resource.data)
            || (request.resource.data.dayOfWeek is int
                && request.resource.data.dayOfWeek >= 1
                && request.resource.data.dayOfWeek <= 7))
        // Le nom recopié de la séance : c'est lui qui rend deux séances
        // comparables. Vide est légitime — un programme peut ne pas nommer
        // ses jours.
        && (!("name" in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 40));
      allow delete: if isOwner(uid);
    }

    // Cache de la dernière perf, dénormalisé dans un seul document : ouvrir la
    // séance du jour ne coûte qu'une lecture. `byInstance` pré-remplit la
    // saisie d'une occurrence, `byExercise` donne l'aperçu du mouvement.
    // Les écritures étant fusionnées, chaque champ n'est validé que s'il est
    // présent dans la requête.
    match /users/{uid}/meta/lastPerf {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!("byInstance" in request.resource.data) || request.resource.data.byInstance is map)
        && (!("byExercise" in request.resource.data) || request.resource.data.byExercise is map);
      allow delete: if isOwner(uid);
    }

    // Journal alimentaire, un document par jour et par personne. Les macros sont
    // figees dans chaque entree a l'ajout : l'historique ne bouge plus ensuite.
    match /users/{uid}/foodLog/{dateId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 60;
      allow delete: if isOwner(uid);
    }

    // Objectifs nutritionnels, par personne (kcal + macros, saisis ou estimes).
    match /users/{uid}/meta/nutritionGoals {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!("kcal" in request.resource.data) || request.resource.data.kcal == null
            || (request.resource.data.kcal is number && request.resource.data.kcal >= 0 && request.resource.data.kcal <= 20000))
        && (!("mode" in request.resource.data) || request.resource.data.mode in ['manual', 'computed'])
        && (!("profile" in request.resource.data) || request.resource.data.profile == null
            || request.resource.data.profile is map);
      allow delete: if isOwner(uid);
    }

    // Notes de réglages, PAR UTILISATEUR — la hauteur de siège de l'un n'est
    // pas celle de l'autre, donc surtout pas dans le catalogue commun.
    match /users/{uid}/exerciseNotes/{exerciseId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if isOwner(uid);
    }

    // Pesées, une par jour.
    match /users/{uid}/weights/{dateId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && isDateId(dateId)
        && request.resource.data.value is number
        && request.resource.data.value > 0
        && request.resource.data.value < 500;
      allow delete: if isOwner(uid);
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
